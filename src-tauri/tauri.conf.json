{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloudborne",
  "version": "0.5.1",
  "identifier": "cn.cloudborne.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cloudborne",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0QUJDNDY1RkIzN0IwNzMKUldSenNEZjdaY1NyTkJxSHhFT0JmNWVVUjJwRC90eGlPR1Y4elVhcmk5VW9lSlhhL0MxL0FEUUUK",
      "endpoints": ["https://github.com/Jia-Ethan/cloudborne-desktop/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
